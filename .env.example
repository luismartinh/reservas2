# Copy to .env and set the new Gemini key locally. Never commit the real key.
GEMINI_API_KEY=

# Asistente: gemini u openai. Completar la clave solo en el archivo privado.
ASISTENTE_PROVEEDOR=gemini
ASISTENTE_OPENAI_MODELO=gpt-5.4-mini
OPENAI_API_KEY=

# Audio independiente del proveedor del chat. Reutiliza OPENAI_API_KEY.
ASISTENTE_AUDIO_HABILITADO=1
ASISTENTE_AUDIO_MODELO=gpt-transcribe
